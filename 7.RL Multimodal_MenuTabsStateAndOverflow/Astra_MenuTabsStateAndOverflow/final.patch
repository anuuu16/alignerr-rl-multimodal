+function revealTab(tab: HTMLElement) {
+  const list = tab.parentElement!;
+  const bounds = list.getBoundingClientRect();
+  const selected = tab.getBoundingClientRect();
+  // Keep a gutter for the overflow hints and focus outline. Only scroll this row.
+  if (selected.left < bounds.left + 20) {
+    list.scrollLeft -= bounds.left + 20 - selected.left;
+  } else if (selected.right > bounds.right - 20) {
+    list.scrollLeft += selected.right - bounds.right + 20;
+  }
+}
