--- /dev/null
+++ b/tests/README.md
@@ -0,0 +1,16 @@
+Menu browser regression check
+
+Run against a running production server (`npm run build`, then
+`npm run start -- --port 3101`). The check uses headless Google Chrome and
+Playwright, with no changes to the app's dependencies:
+
+```sh
+npm install --prefix /tmp/ember-menu-tests playwright
+NODE_PATH=/tmp/ember-menu-tests/node_modules node tests/menu-navigation.mjs
+```
+
+Set `BASE_URL` to test another server. Screenshots and console results cover
+320px, 390px and 1440px viewports: selected-tab visibility, overflow cues,
+keyboard navigation and focus, category URLs, invalid-category fallback,
+reservation dish prefill, Back/Forward scroll restoration, reload and resize.
+Screenshots are written to `artifacts/menu-check/`.
diff --git a/tests/menu-navigation.mjs b/tests/menu-navigation.mjs
new file mode 100644
index 0000000..b53b2f6
--- /dev/null
+++ b/tests/menu-navigation.mjs
@@ -0,0 +1,172 @@
+import { createRequire } from "node:module";
+const { chromium } = createRequire(import.meta.url)("playwright");
+import assert from "node:assert/strict";
+import { mkdirSync } from "node:fs";
+const baseUrl = process.env.BASE_URL || "http://localhost:3101";
+
+(async () => {
+  const browser = await chromium.launch({ headless: true, channel: "chrome" });
+  const root = process.cwd() + "/artifacts/menu-check";
+  mkdirSync(root, { recursive: true });
+  for (const width of [320, 390, 1440]) {
+    const page = await browser.newPage({
+      viewport: { width, height: width === 320 ? 640 : 844 },
+      deviceScaleFactor: 1,
+    });
+    const errors = [];
+    page.on("pageerror", (e) => errors.push(e.message));
+    await page.goto(`${baseUrl}/menu`);
+    await page.getByRole("tab", { name: "Starters", exact: true }).waitFor();
+    await page.waitForTimeout(600);
+    async function check(name) {
+      const tab = page.getByRole("tab", { name, exact: true });
+      assert.equal(await tab.getAttribute("aria-selected"), "true");
+      assert.equal(await page.locator("[role=tabpanel]:visible").count(), 1);
+      const box = await tab.boundingBox();
+      const list = await page.getByRole("tablist").boundingBox();
+      assert(
+        box.x >= list.x - 1 && box.x + box.width <= list.x + list.width + 1,
+        `${name} clipped at ${width}: ${JSON.stringify(box)}`,
+      );
+      assert(
+        await page.evaluate(
+          () => document.documentElement.scrollWidth <= innerWidth,
+        ),
+        "page overflow",
+      );
+    }
+    await page.getByRole("tab", { name: "Drinks", exact: true }).click();
+    await page.waitForTimeout(350);
+    await check("Drinks");
+    assert.equal(
+      await page.locator(".menu-tabs-hint-left").isVisible(),
+      width === 320,
+    );
+    assert.equal(
+      await page.locator(".menu-tabs-hint-right").isVisible(),
+      false,
+    );
+    await page
+      .getByRole("tablist")
+      .evaluate((el) =>
+        window.scrollTo(0, el.getBoundingClientRect().top + scrollY - 100),
+      );
+    await page
+      .locator("[role=tabpanel]:visible img")
+      .evaluateAll((imgs) =>
+        Promise.all(imgs.map((img) => img.decode().catch(() => {}))),
+      );
+    await page.screenshot({ path: `${root}/${width}-drinks.png` });
+    const keys = [
+      ["Home", "Starters"],
+      ["ArrowLeft", "Drinks"],
+      ["ArrowRight", "Starters"],
+      ["End", "Drinks"],
+      ["ArrowLeft", "Desserts"],
+    ];
+    for (const [key, name] of keys) {
+      const y = await page.evaluate(() => scrollY);
+      await page.keyboard.press(key);
+      await page.waitForTimeout(350);
+      await check(name);
+      assert.equal(
+        await page
+          .getByRole("tab", { name, exact: true })
+          .evaluate((el) => el === document.activeElement),
+        true,
+      );
+      assert.equal(
+        await page.evaluate(() => scrollY),
+        y,
+        `keyboard scrolled page at ${width}`,
+      );
+    }
+    const reserve = page
+      .getByRole("tabpanel")
+      .filter({ visible: true })
+      .getByRole("link", { name: /Reserve a table/ })
+      .nth(2);
+    await reserve.scrollIntoViewIfNeeded();
+    await page.waitForTimeout(500);
+    const before = await page.evaluate(() => scrollY);
+    await page
+      .locator("[role=tabpanel]:visible img")
+      .evaluateAll((imgs) =>
+        Promise.all(imgs.map((img) => img.decode().catch(() => {}))),
+      );
+    await page.screenshot({ path: `${root}/${width}-before-reserve.png` });
+    const href = await reserve.getAttribute("href");
+    await reserve.click();
+    await page.waitForURL("**/reserve?dish=*");
+    assert.equal(
+      new URL(page.url()).searchParams.get("dish"),
+      new URL(href, baseUrl).searchParams.get("dish"),
+    );
+    assert.equal(
+      await page
+        .locator("[name=dish_of_interest] option:checked")
+        .textContent(),
+      new URL(page.url()).searchParams.get("dish"),
+    );
+    await page.goBack();
+    await page.waitForURL("**/menu?category=desserts");
+    await page.waitForTimeout(600);
+    await check("Desserts");
+    const after = await page.evaluate(() => scrollY);
+    assert(
+      Math.abs(before - after) <= 2,
+      `Back scroll ${width}: ${before} -> ${after}`,
+    );
+    await page
+      .locator("[role=tabpanel]:visible img")
+      .evaluateAll((imgs) =>
+        Promise.all(imgs.map((img) => img.decode().catch(() => {}))),
+      );
+    await page.screenshot({ path: `${root}/${width}-after-back.png` });
+    await page.goForward();
+    await page.waitForURL("**/reserve?dish=*");
+    await page.goBack();
+    await page.waitForTimeout(300);
+    await check("Desserts");
+    await page.reload();
+    await page.waitForTimeout(500);
+    await check("Desserts");
+    for (const category of [
+      "drinks",
+      "mains",
+      "desserts",
+      "starters",
+      "unknown",
+      "",
+    ]) {
+      await page.goto(`${baseUrl}/menu?source=test&category=${category}#main`);
+      await page.waitForTimeout(200);
+      await check(
+        category && category !== "unknown"
+          ? category[0].toUpperCase() + category.slice(1)
+          : "Starters",
+      );
+    }
+    await page.getByRole("tab", { name: "Drinks", exact: true }).click();
+    await page.waitForTimeout(350);
+    assert.equal(new URL(page.url()).searchParams.get("source"), "test");
+    assert.equal(new URL(page.url()).hash, "#main");
+    await page.setViewportSize({ width: 280, height: 700 });
+    await page.waitForTimeout(200);
+    await check("Drinks");
+    assert.deepEqual(errors, []);
+    console.log(
+      JSON.stringify({
+        width,
+        backScroll: { before, after },
+        checks:
+          "click, keyboard, wrapping, focus, deep links, reload, Back/Forward, resize, URL preservation, no page overflow/errors: PASS",
+      }),
+    );
+    await page.close();
+  }
+  await browser.close();
+})().catch((error) => {
+  console.error(error);
+  process.exit(1);
+});
