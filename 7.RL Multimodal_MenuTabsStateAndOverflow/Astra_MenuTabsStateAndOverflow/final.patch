+/* Overflow cues occupy the tab row's existing gutters, without shifting content. */
+.menu-tabs-hint {
+  position: absolute;
+  top: 0;
+  bottom: 1px;
+  width: 20px;
+  display: none;
+  align-items: center;
+  justify-content: center;
+  pointer-events: none;
+  color: var(--color-muted);
+}
+
+.menu-tabs-hint-left {
+  left: 0;
+  background: linear-gradient(to right, var(--color-bg) 60%, transparent);
+}
+
+.menu-tabs-hint-right {
+  right: 0;
+  background: linear-gradient(to left, var(--color-bg) 60%, transparent);
+}
