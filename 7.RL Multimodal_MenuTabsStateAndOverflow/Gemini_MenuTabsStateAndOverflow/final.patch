@@ -0,0 +1,11 @@
+import site from "@/content/site";
+
+export function getValidCategoryId(raw?: string | null): string | null {
+  if (!raw) return null;
+  const cleaned = raw.trim().toLowerCase().replace(/^#/, "");
+  const found = site.menu.find(
+    (cat) =>
+      cat.id.toLowerCase() === cleaned || cat.label.toLowerCase() === cleaned,
+  );
+  return found ? found.id : null;
+}
