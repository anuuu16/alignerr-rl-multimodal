index 0000000..f5caa91
--- /dev/null
+++ b/e2e/command-palette-layout.spec.ts
@@ -0,0 +1,61 @@
+import { expect, test } from "@playwright/test";
+
+for (const width of [320, 375, 1440]) {
+  test(`command palette fits and works at ${width}px`, async ({ page }, testInfo) => {
+    await page.setViewportSize({ width, height: width < 640 ? 640 : 900 });
+    await page.goto("/");
+    // Wait for hydration before using the global keyboard shortcut.
+    await page.getByRole("button", { name: "Open command palette", exact: true }).click();
+    const dialog = page.getByRole("dialog", { name: "Command palette", exact: true });
+    await expect(dialog).toBeVisible();
+    await page.keyboard.press("Escape");
+    await expect(dialog).toBeHidden();
+    await page.keyboard.press("Meta+k");
+    await expect(dialog).toBeVisible();
+    await page.evaluate(() => document.fonts.ready);
+
+    const panel = page.locator("[cmdk-root] > .relative");
+    const bounds = await panel.boundingBox();
+    expect(bounds).not.toBeNull();
+    expect(bounds!.width).toBe(width < 640 ? width - 24 : 512);
+    expect(bounds!.x).toBe((width - bounds!.width) / 2);
+
+    // Check intrinsic overflow as well as bounds: overflow:hidden alone must not pass.
+    const overflow = await panel.evaluate((element, phone) => {
+      const bounds = element.getBoundingClientRect();
+      const selector = phone
+        ? "[cmdk-list], [cmdk-item], [cmdk-item] span, input"
+        : "[cmdk-list], [cmdk-item], input";
+      return [element, ...element.querySelectorAll(selector)]
+        .filter((node) => {
+          const rect = node.getBoundingClientRect();
+          if (!rect.width || !rect.height) return false;
+          return node.scrollWidth > node.clientWidth + 1 ||
+            rect.left < bounds.left || rect.right > bounds.right;
+        })
+        .map((node) => node.textContent || node.tagName);
+    }, width < 640);
+    expect(overflow).toEqual([]);
+    expect(await page.evaluate(() => document.documentElement.scrollWidth)).toBe(width);
+
+    const search = page.getByRole("combobox", { name: "Search commands" });
+    await expect(search).toHaveAttribute("placeholder", width < 640
+      ? "Search commands…"
+      : "Jump to a page, run an action, or switch view…");
+    await testInfo.attach(`palette-${width}`, {
+      body: await page.screenshot(), contentType: "image/png",
+    });
+
+    // Verify lower results remain reachable through the vertical list.
+    const last = page.getByRole("option").last();
+    await last.scrollIntoViewIfNeeded();
+    await expect(last).toBeInViewport();
+    await search.fill("zzzz-no-such-command");
+    await expect(page.getByText("No results.", { exact: true })).toBeVisible();
+    await search.fill("About");
+    await page.keyboard.press("ArrowDown");
+    await page.getByRole("option", { name: /^About/ }).click();
+    await expect(dialog).toBeHidden();
+    await expect(page).toHaveURL(/\/about$/);
+  });
+}
