diff --git a/e2e/mobile-layout.spec.ts b/e2e/mobile-layout.spec.ts
new file mode 100644
index 0000000..142b803
--- /dev/null
+++ b/e2e/mobile-layout.spec.ts
@@ -0,0 +1,87 @@
+import { test, expect } from "@playwright/test";
+
+for (const width of [390, 320, 1440]) {
+  test(`mobile audit at ${width}px`, async ({ page }, testInfo) => {
+    await page.setViewportSize({ width, height: width === 320 ? 720 : width === 390 ? 844 : 900 });
+    await page.emulateMedia({ reducedMotion: "reduce" });
+    await page.goto("/about");
+    const command = page.getByRole("button", { name: "Open command palette", exact: true });
+    const ask = page.getByRole("button", { name: "Ask my portfolio", exact: true });
+    await expect(ask).toBeVisible();
+    await page.evaluate(() => window.scrollTo({ top: document.body.scrollHeight, behavior: "instant" }));
+    const subscribe = page.getByRole("link", { name: "Subscribe", exact: true });
+    await expect(subscribe).toBeInViewport();
+    if (width < 640) {
+      const footer = await subscribe.boundingBox();
+      const controls = await Promise.all([command.boundingBox(), ask.boundingBox()]);
+      for (const control of controls) expect(footer!.y + footer!.height).toBeLessThan(control!.y);
+      // A trial click checks visibility and hit testing without navigating away.
+      await subscribe.click({ trial: true });
+      await expect(page.locator('nav[aria-label="Machine-readable"]')).toHaveJSProperty("scrollWidth", await page.locator('nav[aria-label="Machine-readable"]').evaluate(el => el.clientWidth));
+    } else {
+      expect(await command.evaluate(el => getComputedStyle(el).bottom)).toBe("20px");
+      expect(await ask.evaluate(el => getComputedStyle(el).left)).toBe("20px");
+      expect(await page.locator("body").evaluate(el => getComputedStyle(el).paddingBottom)).toBe("0px");
+    }
+    await page.screenshot({ path: `artifacts/mobile-audit/${testInfo.project.name}-${width}-about.png` });
+
+    if (width < 640) {
+      const menu = page.getByRole("button", { name: "Open menu", exact: true });
+      await menu.click();
+      const dialog = page.getByRole("dialog", { name: "Site navigation" });
+      await expect(dialog).toBeVisible();
+      const backdrop = page.getByTestId("mobile-nav-backdrop");
+      const bounds = await backdrop.boundingBox();
+      expect(bounds!.height).toBe(page.viewportSize()!.height - 56);
+      await expect(page.locator("body")).toHaveCSS("overflow", "hidden");
+      await page.screenshot({ path: `artifacts/mobile-audit/${testInfo.project.name}-${width}-menu.png` });
+      await page.mouse.click(width / 2, page.viewportSize()!.height - 100);
+      await expect(dialog).not.toBeVisible();
+      await expect(menu).toBeFocused();
+      await menu.click();
+      await page.keyboard.press("Escape");
+      await expect(dialog).not.toBeVisible();
+      await menu.click();
+      await dialog.getByRole("link", { name: "Projects", exact: true }).click();
+      await expect(page).toHaveURL(/\/projects$/);
+      await expect(dialog).not.toBeVisible();
+    }
+
+    await page.goto("/?view=chat");
+    await expect(page.getByLabel("Ask a question about Sairam")).toBeVisible({ timeout: 30000 });
+    const label = page.getByText("AI Concierge", { exact: true });
+    const labelBox = await label.boundingBox();
+    expect(labelBox!.x).toBeGreaterThanOrEqual(0);
+    expect(labelBox!.x + labelBox!.width).toBeLessThanOrEqual(width);
+    const caption = page.getByText("Grounded in real work · may simplify details", { exact: true });
+    await expect(caption).toBeInViewport();
+    if (width < 640) {
+      const captionBox = await caption.boundingBox();
+      const commandBox = await command.boundingBox();
+      expect(captionBox!.y + captionBox!.height).toBeLessThan(commandBox!.y);
+    }
+    const sendBox = await page.getByRole("button", { name: "Send", exact: true }).boundingBox();
+    expect(sendBox!.x + sendBox!.width).toBeLessThan(width);
+    await expect(page.getByRole("heading", { name: "Ask me anything about Sairam's work", exact: true })).toBeInViewport();
+    await page.screenshot({ path: `artifacts/mobile-audit/${testInfo.project.name}-${width}-chat.png` });
+  });
+}
+
+// Exercise the shared clearance on document routes and the other view layouts.
+test("mobile clearance applies across routes and views", async ({ page }) => {
+  test.setTimeout(120000);
+  await page.setViewportSize({ width: 320, height: 720 });
+  for (const route of ["/", "/work", "/projects", "/articles", "/resume", "/?view=gamified", "/?view=developer"]) {
+    await page.goto(route);
+    await expect(page.getByRole("button", { name: "Open command palette", exact: true })).toBeVisible();
+    await expect(page.locator("body")).toHaveCSS("padding-bottom", "80px");
+    await page.evaluate(() => window.scrollTo({ top: document.body.scrollHeight, behavior: "instant" }));
+    const footer = page.getByRole("link", { name: "Subscribe", exact: true });
+    if (route.includes("developer")) {
+      await expect(page.getByRole("heading", { name: "Query my work via the CLI" })).toBeVisible();
+      await expect(footer).toHaveCount(0);
+    } else {
+      await footer.click({ trial: true });
+    }
+  }
+});
diff --git a/src/app/globals.css b/src/app/globals.css
index 944e3a5..31a1df4 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -441,3 +441,16 @@ body::before {
   }
 }
 
+
+/* One mobile clearance budget shared by document pages and bounded consoles.
+   Include the home indicator inset so the launchers stay above the safe area. */
+:root { --mobile-action-space: 0px; }
+@media (width < 640px) {
+  :root { --mobile-action-space: calc(5rem + env(safe-area-inset-bottom, 0px)); }
+  body { padding-bottom: var(--mobile-action-space); }
+  html { scroll-padding-bottom: var(--mobile-action-space); }
+  .portfolio-launcher,
+  .command-launcher { bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px)); }
+  .portfolio-launcher { left: 0.75rem; }
+  .command-launcher { right: 0.75rem; }
+}
