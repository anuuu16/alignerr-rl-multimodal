diff --git a/src/components/mobile-nav.dom.test.tsx b/src/components/mobile-nav.dom.test.tsx
new file mode 100644
index 0000000..ac22f4d
--- /dev/null
+++ b/src/components/mobile-nav.dom.test.tsx
@@ -0,0 +1,88 @@
+import { describe, it, expect, vi, afterEach } from "vitest";
+import { render, screen, fireEvent, cleanup } from "@testing-library/react";
+import { MobileNav } from "./mobile-nav";
+import { ViewProvider } from "@/components/view-context";
+import { TooltipProvider } from "@/components/ui/tooltip";
+
+vi.mock("next/navigation", () => ({
+  useSearchParams: () => new URLSearchParams(),
+  useRouter: () => ({ push: vi.fn() }),
+  usePathname: () => "/",
+}));
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+const sampleLinks = [
+  { href: "/work", label: "Work" },
+  { href: "/about", label: "About" },
+];
+
+function renderNav() {
+  return render(
+    <TooltipProvider>
+      <ViewProvider>
+        <MobileNav links={sampleLinks} />
+      </ViewProvider>
+    </TooltipProvider>,
+  );
+}
+
+describe("MobileNav drawer & backdrop", () => {
+  it("opens menu on trigger click and portals backdrop and panel into body", () => {
+    renderNav();
+
+    const trigger = screen.getByRole("button", { name: "Open menu" });
+    expect(trigger).toBeTruthy();
+    expect(document.getElementById("mobile-nav-panel")).toBeNull();
+
+    fireEvent.click(trigger);
+
+    const panel = document.getElementById("mobile-nav-panel");
+    expect(panel).toBeTruthy();
+    expect(panel?.parentElement).toBe(document.body);
+
+    const backdrop = document.querySelector('div[aria-hidden="true"].backdrop-blur-sm');
+    expect(backdrop).toBeTruthy();
+    expect(backdrop?.parentElement).toBe(document.body);
+  });
+
+  it("closes menu when backdrop is clicked (tap outside)", () => {
+    renderNav();
+
+    const trigger = screen.getByRole("button", { name: "Open menu" });
+    fireEvent.click(trigger);
+    expect(document.getElementById("mobile-nav-panel")).toBeTruthy();
+
+    const backdrop = document.querySelector('div[aria-hidden="true"].backdrop-blur-sm');
+    expect(backdrop).toBeTruthy();
+    fireEvent.click(backdrop!);
+
+    expect(document.getElementById("mobile-nav-panel")).toBeNull();
+  });
+
+  it("closes menu when Escape key is pressed", () => {
+    renderNav();
+
+    const trigger = screen.getByRole("button", { name: "Open menu" });
+    fireEvent.click(trigger);
+    expect(document.getElementById("mobile-nav-panel")).toBeTruthy();
+
+    fireEvent.keyDown(document, { key: "Escape" });
+    expect(document.getElementById("mobile-nav-panel")).toBeNull();
+  });
+
+  it("closes menu when a nav link is clicked", () => {
+    renderNav();
+
+    const trigger = screen.getByRole("button", { name: "Open menu" });
+    fireEvent.click(trigger);
+
+    const aboutLink = screen.getByRole("link", { name: "About" });
+    fireEvent.click(aboutLink);
+
+    expect(document.getElementById("mobile-nav-panel")).toBeNull();
+  });
+});
