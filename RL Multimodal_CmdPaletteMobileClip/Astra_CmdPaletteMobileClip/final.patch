diff --git a/e2e/command-palette-responsive.spec.ts b/e2e/command-palette-responsive.spec.ts
new file mode 100644
index 0000000..cc05508
--- /dev/null
+++ b/e2e/command-palette-responsive.spec.ts
@@ -0,0 +1,47 @@
+import { test, expect } from "@playwright/test";
+
+for (const width of [320, 375, 1440]) {
+  test(`command palette fits and works at ${width}px`, async ({ page }, testInfo) => {
+    await page.setViewportSize({ width, height: width < 640 ? 640 : 900 });
+    await page.goto("/");
+    await page.getByRole("button", { name: "Open command palette", exact: true }).click();
+    const input = page.getByRole("combobox");
+    await expect(input).toBeFocused();
+    const root = page.locator("[cmdk-root]");
+    const bounds = await root.boundingBox();
+    expect(bounds!.width).toBe(width < 640 ? width - 24 : 512);
+    expect(bounds!.x).toBe((width - bounds!.width) / 2);
+
+    // Check the actual content, not just a container hiding oversized children.
+    expect(await root.evaluate((el) => {
+      const panel = el.lastElementChild!;
+      const bounds = panel.getBoundingClientRect();
+      return Array.from(panel.querySelectorAll<HTMLElement>("input, [cmdk-list], [cmdk-item], [cmdk-item] span, [cmdk-item] svg"))
+        .filter((node) => node.getClientRects().length > 0)
+        .filter((node) => {
+          const rect = node.getBoundingClientRect();
+          return rect.left < bounds.left || rect.right > bounds.right || (window.innerWidth < 640 && node.scrollWidth > node.clientWidth + 1);
+        })
+        .map((node) => node.textContent || node.tagName);
+    })).toEqual([]);
+    expect(await page.evaluate(() => document.documentElement.scrollWidth)).toBe(width);
+    if (width < 640) await expect(input).toHaveAttribute("placeholder", "Search commands…");
+    await page.screenshot({ path: `artifacts/palette/after-${testInfo.project.name}-${width}.png` });
+
+    const list = page.getByRole("listbox");
+    await list.evaluate((el) => { el.scrollTop = el.scrollHeight; });
+    await expect(page.getByRole("option").last()).toBeInViewport();
+    await input.fill("Projects");
+    const projects = page.getByRole("option", { name: "Projects 11 repos", exact: true });
+    await expect(projects).toBeVisible();
+    await page.keyboard.press("ArrowDown");
+    await expect(page.locator('[cmdk-item][data-selected="true"]')).toHaveCount(1);
+    await projects.click();
+    await expect(page).toHaveURL(/\/projects$/);
+    await expect(page.getByRole("dialog")).toHaveCount(0);
+    await page.keyboard.press("Meta+k");
+    await expect(input).toBeVisible();
+    await page.keyboard.press("Escape");
+    await expect(page.getByRole("dialog")).toHaveCount(0);
+  });
+}
