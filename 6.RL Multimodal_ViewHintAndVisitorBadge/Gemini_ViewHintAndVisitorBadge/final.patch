diff --git a/src/components/view-hint.dom.test.tsx b/src/components/view-hint.dom.test.tsx
new file mode 100644
index 0000000..5569a1e
--- /dev/null
+++ b/src/components/view-hint.dom.test.tsx
@@ -0,0 +1,149 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import { render, screen, fireEvent, act, cleanup } from "@testing-library/react";
+import { ViewHint } from "./view-hint";
+
+let mockPathname = "/";
+let mockView = "classic";
+
+vi.mock("next/navigation", () => ({
+  usePathname: () => mockPathname,
+  useSearchParams: () => new URLSearchParams(),
+}));
+
+vi.mock("@/components/view-context", () => ({
+  useView: () => ({ view: mockView }),
+}));
+
+describe("ViewHint component", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    mockPathname = "/";
+    mockView = "classic";
+    localStorage.clear();
+  });
+
+  afterEach(() => {
+    act(() => {
+      vi.runOnlyPendingTimers();
+    });
+    vi.useRealTimers();
+    cleanup();
+    localStorage.clear();
+  });
+
+  it("does not render before the 7-second dwell delay on home page", () => {
+    render(<ViewHint />);
+    expect(screen.queryByText(/Try a different view/)).toBeNull();
+
+    act(() => {
+      vi.advanceTimersByTime(6999);
+    });
+    expect(screen.queryByText(/Try a different view/)).toBeNull();
+  });
+
+  it("renders on the home page ('/') after the 7-second dwell delay", () => {
+    render(<ViewHint />);
+
+    act(() => {
+      vi.advanceTimersByTime(7000);
+    });
+
+    expect(screen.getByText(/Try a different view/)).toBeTruthy();
+  });
+
+  it("does NOT render on /work even after 7 seconds", () => {
+    mockPathname = "/work";
+    render(<ViewHint />);
+
+    act(() => {
+      vi.advanceTimersByTime(10000);
+    });
+
+    expect(screen.queryByText(/Try a different view/)).toBeNull();
+  });
+
+  it("does NOT render on /projects even after 7 seconds", () => {
+    mockPathname = "/projects";
+    render(<ViewHint />);
+
+    act(() => {
+      vi.advanceTimersByTime(10000);
+    });
+
+    expect(screen.queryByText(/Try a different view/)).toBeNull();
+  });
+
+  it("does NOT render on /articles or sub-routes even after 7 seconds", () => {
+    mockPathname = "/articles";
+    render(<ViewHint />);
+
+    act(() => {
+      vi.advanceTimersByTime(10000);
+    });
+
+    expect(screen.queryByText(/Try a different view/)).toBeNull();
+
+    cleanup();
+    mockPathname = "/work/pensieve";
+    render(<ViewHint />);
+
+    act(() => {
+      vi.advanceTimersByTime(10000);
+    });
+
+    expect(screen.queryByText(/Try a different view/)).toBeNull();
+  });
+
+  it("does NOT render when view is not classic", () => {
+    mockView = "chat";
+    render(<ViewHint />);
+
+    act(() => {
+      vi.advanceTimersByTime(10000);
+    });
+
+    expect(screen.queryByText(/Try a different view/)).toBeNull();
+  });
+
+  it("dismisses on close button click and saves dismissal to localStorage", () => {
+    render(<ViewHint />);
+
+    act(() => {
+      vi.advanceTimersByTime(7000);
+    });
+
+    const dismissBtn = screen.getByRole("button", { name: /Dismiss hint/i });
+    act(() => {
+      fireEvent.click(dismissBtn);
+    });
+
+    expect(screen.queryByText(/Try a different view/)).toBeNull();
+    expect(localStorage.getItem("anvilry-hint-seen")).toBeTruthy();
+  });
+
+  it("does NOT render if previously dismissed within 24h", () => {
+    localStorage.setItem("anvilry-hint-seen", String(Date.now()));
+    render(<ViewHint />);
+
+    act(() => {
+      vi.advanceTimersByTime(10000);
+    });
+
+    expect(screen.queryByText(/Try a different view/)).toBeNull();
+  });
+
+  it("hides when navigating away from the home page", () => {
+    const { rerender } = render(<ViewHint />);
+
+    act(() => {
+      vi.advanceTimersByTime(7000);
+    });
+
+    expect(screen.getByText(/Try a different view/)).toBeTruthy();
+
+    mockPathname = "/work";
+    rerender(<ViewHint />);
+
+    expect(screen.queryByText(/Try a different view/)).toBeNull();
+  });
+});
