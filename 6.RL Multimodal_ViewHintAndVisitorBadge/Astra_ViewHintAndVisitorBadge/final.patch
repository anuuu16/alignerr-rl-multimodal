diff --git a/e2e/view-hint-visitor.spec.ts b/e2e/view-hint-visitor.spec.ts
new file mode 100644
index 0000000..6ef6107
--- /dev/null
+++ b/e2e/view-hint-visitor.spec.ts
@@ -0,0 +1,82 @@
+import { test, expect } from "@playwright/test";
+
+const cacheKey = "anvilry:visits:total";
+
+for (const width of [390, 1440]) {
+  test.describe(`${width}px`, () => {
+    test.use({ viewport: { width, height: width === 390 ? 844 : 900 } });
+
+    test("hint is home-only, including client navigation and dismissal", async ({ page }, testInfo) => {
+      test.setTimeout(120_000);
+      for (const route of ["/work", "/projects", "/articles", "/work/pensieve", "/about"]) {
+        await page.goto(route);
+        await expect(page.locator("main").first()).toBeVisible();
+        await page.waitForTimeout(8000);
+        await expect(page.getByText("Try a different view", { exact: true })).toHaveCount(0);
+        if (route === "/work" || route === "/projects") {
+          await page.screenshot({ path: testInfo.outputPath(`${route.slice(1)}.png`) });
+        }
+      }
+      await page.goto("/");
+      const hint = page.getByText("Try a different view", { exact: true });
+      await expect(hint).toBeVisible({ timeout: 12_000 });
+      await page.locator('a[href="/work"]').filter({ visible: true }).first().click();
+      await expect(page).toHaveURL(/\/work$/);
+      // Cache Components retains the previous page in a hidden Activity tree.
+      await expect(hint).toBeHidden();
+      await page.locator('a[href="/"]').filter({ visible: true }).first().click();
+      await expect(page).toHaveURL(/\/$/);
+      await expect(hint).toBeVisible({ timeout: 12_000 });
+      await page.getByRole("button", { name: "Dismiss hint" }).click();
+      await page.reload();
+      await page.waitForTimeout(8000);
+      await expect(hint).toHaveCount(0);
+    });
+
+    for (const scenario of ["zero", "error", "network", "malformed", "timeout", "success"] as const) {
+      for (const cached of [false, true]) {
+        test(`counter ${scenario}, ${cached ? "returning" : "first"} visitor`, async ({ page }, testInfo) => {
+          if (cached) await page.addInitScript(([key]) => {
+            if (localStorage.getItem(key) === null) localStorage.setItem(key, "1500");
+          }, [cacheKey]);
+          await page.route("**/api/visit", async (route) => {
+            if (scenario === "timeout") return;
+            if (scenario === "network") return route.abort();
+            if (scenario === "error") return route.fulfill({ status: 503, body: "Unavailable" });
+            if (scenario === "malformed") return route.fulfill({ contentType: "application/json", body: "{" });
+            return route.fulfill({ json: { total: scenario === "success" ? 2042 : 0, today: 0 } });
+          });
+          await page.goto("/about");
+          const footer = page.locator("footer");
+          await footer.scrollIntoViewIfNeeded();
+          await expect(footer.locator(".animate-pulse")).toHaveCount(0, { timeout: 15_000 });
+          // Allow the request to settle even when the cached number hides the skeleton immediately.
+          if (cached) await page.waitForTimeout(scenario === "timeout" ? 11_000 : 500);
+          const expected = scenario === "success" ? "2042" : cached ? "1500" : null;
+          if (expected) await expect(footer).toContainText(`${Number(expected).toLocaleString("en-US")} engineers visited`);
+          else await expect(footer.getByText(/engineers visited/)).toHaveCount(0);
+          await expect.poll(() => page.evaluate((key) => localStorage.getItem(key), cacheKey)).toBe(expected);
+          if (!cached && ["zero", "success"].includes(scenario)) {
+            await page.screenshot({ path: testInfo.outputPath(`footer-${scenario}.png`) });
+          }
+          if (scenario === "success") {
+            await page.route("**/api/visit", (route) => route.fulfill({ json: { total: 0, today: 0 } }));
+            await page.reload();
+            await expect(footer).toContainText("2,042 engineers visited");
+            await expect(footer.locator(".animate-pulse")).toHaveCount(0);
+            expect(await page.evaluate((key) => localStorage.getItem(key), cacheKey)).toBe("2042");
+          }
+        });
+      }
+    }
+
+    test("unmocked Redis-down response has no placeholder after 15 seconds", async ({ page }, testInfo) => {
+      await page.goto("/about");
+      await page.locator("footer").scrollIntoViewIfNeeded();
+      await page.waitForTimeout(15_000);
+      await expect(page.locator("footer .animate-pulse")).toHaveCount(0);
+      await expect(page.locator("footer").getByText(/engineers visited/)).toHaveCount(0);
+      await page.screenshot({ path: testInfo.outputPath("footer-real-api.png") });
+    });
+  });
+}
