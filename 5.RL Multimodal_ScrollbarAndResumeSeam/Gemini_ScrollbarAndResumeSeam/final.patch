@@ -71,6 +71,17 @@ html {
   overflow-x: hidden;
 }
 
+/* Full-height views (chat and developer) fit exactly in the viewport without page scroll */
+html[data-full-height="true"],
+html[data-full-height="true"] body {
+  height: 100dvh;
+  overflow: hidden;
+}
+
+html[data-full-height="true"] #main-content {
+  min-height: 0;
+}
+
 @media (prefers-reduced-motion: reduce) {
   html { scroll-behavior: auto; }
 }
