@@ -395,3 +395,29 @@ body {
   }
 }
 
+
+/* Console views share the remaining viewport after the actual site chrome.
+   The hiring banner wraps on phones; no fixed nav/banner subtraction is safe.
+   Scope to the mounted home router so other routes retain document scrolling. */
+body:has([data-viewport-view]) {
+  height: 100dvh;
+  min-height: 0;
+}
+body:has([data-viewport-view]) > * {
+  flex-shrink: 0;
+}
+body:has([data-viewport-view]) #main-content {
+  min-height: 0;
+  flex: 1;
+}
+[data-viewport-view] {
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  min-height: 0;
+}
+[data-viewport-view] > [role="status"] {
+  height: auto;
+  min-height: 0;
+  flex: 1;
+}
