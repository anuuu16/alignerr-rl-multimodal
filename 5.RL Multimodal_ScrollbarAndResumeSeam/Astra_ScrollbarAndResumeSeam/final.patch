diff --git a/e2e/viewport-layout.spec.ts b/e2e/viewport-layout.spec.ts
new file mode 100644
index 0000000..eefbfc7
--- /dev/null
+++ b/e2e/viewport-layout.spec.ts
@@ -0,0 +1,48 @@
+import { test, expect } from "@playwright/test";
+
+for (const viewport of [{ width: 1440, height: 900 }, { width: 390, height: 844 }]) {
+  for (const view of ["chat", "developer"]) {
+    test(`${view} contains scrolling at ${viewport.width}px`, async ({ page }) => {
+      await page.setViewportSize(viewport);
+      await page.goto(`/?view=${view}`);
+      const input = page.getByLabel(view === "chat" ? "Ask a question about Sairam" : "Terminal command input");
+      await expect(input).toBeVisible();
+      const measure = () => page.evaluate(() => ({
+        height: document.documentElement.scrollHeight,
+        width: document.documentElement.scrollWidth,
+        y: window.scrollY,
+        navTop: document.querySelector("body > header")!.getBoundingClientRect().top,
+      }));
+      const expected = { height: viewport.height, width: viewport.width, y: 0, navTop: 0 };
+      await expect.poll(measure).toEqual(expected);
+      await page.mouse.move(5, 400);
+      await page.mouse.wheel(0, 1200);
+      await expect.poll(measure).toEqual(expected);
+
+      if (view === "chat") {
+        // Deterministic overflow without relying on credentials or a live LLM.
+        await page.route("**/api/chat", route => route.fulfill({
+          contentType: "text/plain",
+          body: "A long answer exercising transcript overflow.\n\n".repeat(120),
+        }));
+        await input.fill("Check transcript scrolling");
+        await page.getByRole("button", { name: "Send", exact: true }).click();
+      } else {
+        for (let i = 0; i < 5; i++) await page.getByRole("button", { name: "ls work", exact: true }).click();
+      }
+      const log = page.locator(view === "chat" ? '[tabindex="-1"][aria-live="polite"]' : '[role="log"]');
+      await expect.poll(() => log.evaluate(el => el.scrollHeight > el.clientHeight && el.clientHeight > 0)).toBe(true);
+      await log.evaluate(el => { el.scrollTop = 0; });
+      await log.hover();
+      await page.mouse.wheel(0, 300);
+      await expect.poll(() => log.evaluate(el => el.scrollTop)).toBeGreaterThan(0);
+      await expect.poll(measure).toEqual(expected);
+      await expect(input).toBeInViewport();
+
+      // View-scoped sizing must be removed when returning to the document view.
+      await page.getByRole("button", { name: "Back to Classic" }).click();
+      await expect(page.locator("[data-viewport-view]")).toHaveCount(0);
+      await expect.poll(() => page.evaluate(() => document.documentElement.scrollHeight)).toBeGreaterThan(viewport.height);
+    });
+  }
+}
